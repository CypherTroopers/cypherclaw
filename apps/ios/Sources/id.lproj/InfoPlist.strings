/* OpenClaw source: "CypherClaw uses your contacts so you can search and reference people while using the assistant." */
"NSContactsUsageDescription" = "CypherClaw menggunakan kontak Anda agar Anda dapat mencari dan merujuk orang saat menggunakan asisten.";
/* OpenClaw source: "CypherClaw reads your steps, sleep, resting heart rate, and workouts from the Apple Health app to create summaries you request and send them through your Gateway to your configured AI provider." */
"NSHealthShareUsageDescription" = "CypherClaw membaca data langkah, tidur, detak jantung istirahat, dan olahraga Anda dari aplikasi Apple Health untuk membuat ringkasan yang Anda minta dan mengirimkannya melalui Gateway Anda ke penyedia AI yang telah Anda konfigurasi.";
/* OpenClaw source: "CypherClaw does not write to the Apple Health app. It uses read-only data to create summaries you request and send them through your Gateway to your configured AI provider." */
"NSHealthUpdateUsageDescription" = "CypherClaw tidak menulis data ke aplikasi Apple Health. CypherClaw menggunakan data hanya-baca untuk membuat ringkasan yang Anda minta dan mengirimkannya melalui Gateway Anda ke penyedia AI yang telah Anda konfigurasikan.";
/* OpenClaw source: "CypherClaw discovers and connects to your CypherClaw gateway on the local network." */
"NSLocalNetworkUsageDescription" = "CypherClaw menemukan dan terhubung ke gateway CypherClaw Anda di jaringan lokal.";
/* OpenClaw source: "CypherClaw can share your location in the background when you enable Always." */
"NSLocationAlwaysAndWhenInUseUsageDescription" = "CypherClaw dapat membagikan lokasi Anda di latar belakang saat Anda mengaktifkan Selalu.";
/* OpenClaw source: "CypherClaw uses your location when you allow location sharing." */
"NSLocationWhenInUseUsageDescription" = "CypherClaw menggunakan lokasi Anda saat Anda mengizinkan berbagi lokasi.";
/* OpenClaw source: "CypherClaw uses the microphone for realtime chat, voice wake, push-to-talk, and voice notes." */
"NSMicrophoneUsageDescription" = "CypherClaw menggunakan mikrofon untuk obrolan waktu nyata, aktivasi suara, tekan-untuk-bicara, dan catatan suara.";
/* OpenClaw source: "CypherClaw may use motion data to support device-aware interactions and automations." */
"NSMotionUsageDescription" = "CypherClaw dapat menggunakan data gerakan untuk mendukung interaksi dan otomatisasi yang mempertimbangkan kondisi perangkat.";
/* OpenClaw source: "CypherClaw lets your assistant read photos you allow and lets you choose photos to share." */
"NSPhotoLibraryUsageDescription" = "CypherClaw memungkinkan asisten Anda membaca foto yang Anda izinkan dan memungkinkan Anda memilih foto untuk dibagikan.";
/* OpenClaw source: "CypherClaw uses your reminders to list, add, and complete tasks when you enable reminders access." */
"NSRemindersFullAccessUsageDescription" = "CypherClaw menggunakan pengingat Anda untuk menampilkan daftar, menambahkan, dan menyelesaikan tugas saat Anda mengaktifkan akses pengingat.";
/* OpenClaw source: "CypherClaw uses on-device speech recognition for talk mode and voice wake." */
