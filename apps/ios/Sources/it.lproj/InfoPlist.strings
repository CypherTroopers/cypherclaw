/* OpenClaw source: "CypherClaw uses your calendars to show events and scheduling context when you enable calendar access." */
"NSCalendarsUsageDescription" = "CypherClaw usa i tuoi calendari per mostrare eventi e informazioni di contesto sulla pianificazione quando abiliti l'accesso al calendario.";
/* OpenClaw source: "CypherClaw uses your calendars to add events when you enable calendar access." */
"NSCalendarsWriteOnlyAccessUsageDescription" = "CypherClaw usa i tuoi calendari per aggiungere eventi quando abiliti l'accesso al calendario.";
/* OpenClaw source: "CypherClaw uses the camera when you scan a Gateway setup QR code or ask your paired Gateway or assistant to capture a photo or short video from this iPhone, for example to connect to your Gateway or show your assistant a document, device screen, or workspace." */
"NSCameraUsageDescription" = "CypherClaw utilizza la fotocamera quando scansioni un codice QR di configurazione del Gateway o chiedi al Gateway abbinato o all'assistente di acquisire una foto o un breve video da questo iPhone, ad esempio per connetterti al tuo Gateway o mostrare all'assistente un documento, lo schermo di un dispositivo o uno spazio di lavoro.";
/* OpenClaw source: "CypherClaw uses your contacts so you can search and reference people while using the assistant." */
"NSContactsUsageDescription" = "CypherClaw usa i tuoi contatti per consentirti di cercare e menzionare persone mentre usi l'assistente.";
/* OpenClaw source: "CypherClaw reads your steps, sleep, resting heart rate, and workouts from the Apple Health app to create summaries you request and send them through your Gateway to your configured AI provider." */
"NSHealthShareUsageDescription" = "CypherClaw legge i tuoi passi, il sonno, la frequenza cardiaca a riposo e gli allenamenti dall'app Salute di Apple per creare i riepiloghi che richiedi e inviarli tramite il tuo Gateway al provider di IA configurato.";
/* OpenClaw source: "CypherClaw does not write to the Apple Health app. It uses read-only data to create summaries you request and send them through your Gateway to your configured AI provider." */
"NSHealthUpdateUsageDescription" = "CypherClaw non scrive dati nell'app Salute di Apple. Utilizza i dati in sola lettura per creare i riepiloghi richiesti e inviarli tramite il tuo Gateway al provider di IA configurato.";
/* OpenClaw source: "CypherClaw discovers and connects to your CypherClaw gateway on the local network." */
"NSLocalNetworkUsageDescription" = "CypherClaw rileva il tuo gateway CypherClaw sulla rete locale e vi si connette.";
/* OpenClaw source: "CypherClaw can share your location in the background when you enable Always." */
"NSLocationAlwaysAndWhenInUseUsageDescription" = "CypherClaw può condividere la tua posizione in background quando abiliti Sempre.";
/* OpenClaw source: "CypherClaw uses your location when you allow location sharing." */
"NSLocationWhenInUseUsageDescription" = "CypherClaw usa la tua posizione quando consenti la condivisione della posizione.";
/* OpenClaw source: "CypherClaw uses the microphone for realtime chat, voice wake, push-to-talk, and voice notes." */
"NSMicrophoneUsageDescription" = "CypherClaw usa il microfono per la chat in tempo reale, l'attivazione vocale, la funzione push-to-talk e i messaggi vocali.";
/* OpenClaw source: "CypherClaw may use motion data to support device-aware interactions and automations." */
"NSMotionUsageDescription" = "CypherClaw può utilizzare i dati di movimento per supportare interazioni e automazioni sensibili al dispositivo.";
/* OpenClaw source: "CypherClaw lets your assistant read photos you allow and lets you choose photos to share." */
"NSPhotoLibraryUsageDescription" = "CypherClaw consente al tuo assistente di leggere le foto che autorizzi e ti permette di scegliere le foto da condividere.";
/* OpenClaw source: "CypherClaw uses your reminders to list, add, and complete tasks when you enable reminders access." */
"NSRemindersFullAccessUsageDescription" = "CypherClaw usa i tuoi promemoria per elencare, aggiungere e completare attività quando abiliti l'accesso ai promemoria.";
/* OpenClaw source: "CypherClaw uses on-device speech recognition for talk mode and voice wake." */
